# Copy this file to .env in the same folder and fill it in.
# .env is gitignored — never commit a real key.

# Portkey gateway (OpenAI-compatible). Key comes from the course.
PORTKEY_API_KEY=
PORTKEY_BASE_URL=https://api.portkey.ai/v1

# Chat model. Agents.md sets the workspace default; override here, not in code.
OPENAI_MODEL=gpt-5.6-luna

# gpt-*-luna rejects function tools unless this is "none"
LLM_REASONING_EFFORT=none

# Comma-separated origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173

# PBKDF2 iteration count. Must match the supplied database — changing it
# locks every seeded account out.
PBKDF2_ITERATIONS=120000
